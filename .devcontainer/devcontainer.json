{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "homebrew-tap",
  "build": {
    "dockerfile": "Containerfile",
    "context": "."
  },

  // Podman-compatible: rootless with SELinux label passthrough
  // Mount host Homebrew so brew audit/style/tap use the real install
  "runArgs": [
    "--userns=keep-id",
    "--security-opt=label=disable"
  ],
  "mounts": [
    "source=/home/linuxbrew,target=/home/linuxbrew,type=bind,Z"
  ],
  "containerUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/homebrew-tap,type=bind,Z",
  "workspaceFolder": "/workspaces/homebrew-tap",

  "postCreateCommand": "brew tap castrojo/tap $(pwd) && ./scripts/setup-hooks.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
